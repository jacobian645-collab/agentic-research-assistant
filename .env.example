# ─── LLM provider ──────────────────────────────────────────────────────────
# bedrock (default) | anthropic | openai | azure_openai | fake (offline, no keys)
LLM_PROVIDER=bedrock
AWS_REGION=us-west-2
# AWS_PROFILE=default          # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an instance/task role

# Model tiers (Bedrock cross-region inference profile IDs).
#   global.*  → best availability, no premium (data may be processed in any region)
#   us./eu./jp./apac.* → geography-pinned routing for data residency (~10% premium)
MODEL_REASONING=global.anthropic.claude-sonnet-4-6
MODEL_FAST=global.anthropic.claude-haiku-4-5-20251001-v1:0
JUDGE_MODEL=global.anthropic.claude-opus-4-6-v1
# JUDGE_PROVIDER=openai        # optional: different model family as judge (reduces self-preference)

# Other providers
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/

# ─── Tools (MCP) ───────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio            # stdio (local) | streamable_http (docker-compose / k8s)
WEB_SEARCH_PROVIDER=offline    # offline | ddg | tavily
# TAVILY_API_KEY=tvly-...
RETRIEVAL_EMBEDDINGS=hash      # none | hash | bedrock (Titan Text Embeddings v2)

# ─── Budgets & guardrails ──────────────────────────────────────────────────
MAX_RESEARCH_ROUNDS=2
MAX_REVISIONS=2
MAX_PARALLEL_WORKERS=4
MAX_TOOL_CALLS_PER_WORKER=6
MAX_COST_USD=0.50
REQUIRE_PLAN_APPROVAL=false

# ─── Evaluation ────────────────────────────────────────────────────────────
EVAL_MIN_OVERALL=3.5
ONLINE_EVAL_SAMPLE_RATE=0.0

# ─── Service & observability ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
# API_KEY=change-me
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=agentic-research-assistant
